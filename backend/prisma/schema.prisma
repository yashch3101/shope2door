generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// =====================================================
// USER
// =====================================================

model User {
  id String @id @default(cuid())

  // Legacy customer ID from old database
  legacyId Int? @unique

  name String

  // Kept required because the existing authentication
  // system already expects an email.
  email String @unique

  // Original legacy email, if any.
  // Useful when duplicate/invalid legacy emails
  // have to be normalized during migration.
  legacyEmail String?

  phone String? @unique

  password String

  role UserRole @default(CUSTOMER)

  legacyOtpChallenges LegacyOtpChallenge[]

  isActive Boolean @default(true)

  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]
  payments  Payment[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([legacyId])
}

// =====================================================
// LEGACY CUSTOMER OTP
// =====================================================

model LegacyOtpChallenge {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash String

  expiresAt DateTime

  attempts Int @default(0)

  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

// =====================================================
// CATEGORY
// =====================================================

model Category {
  id String @id @default(cuid())

  // Legacy main_category.id
  legacyId Int? @unique

  name String

  slug String @unique

  description String?

  image String?

  icon String?

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  banners Banner[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([legacyId])
}

// =====================================================
// PRODUCT
// =====================================================

model Product {
  id String @id @default(cuid())

  // Legacy products.id
  legacyId Int? @unique

  name String

  slug String @unique

  description String?

  // Legacy product "types" field.
  // Examples in legacy data include:
  // normal
  // normal,Everyday Essentials
  // normal,Hot deals
  legacyTypes String?

  // ===================================================
  // PRICING
  // ===================================================

  price Decimal @db.Decimal(10, 2)

  mrp Decimal @db.Decimal(10, 2)

  costPrice Decimal? @db.Decimal(10, 2)

  // ===================================================
  // INVENTORY
  // ===================================================

  stock Int @default(0)

  unit String?

  weight String?

  // ===================================================
  // PRODUCT INFORMATION
  // ===================================================

  brand String?

  sku String? @unique

  // Keep existing frontend compatibility.
  // Migrated product image URLs will also be stored here.
  images String[]

  // ===================================================
  // PRODUCT STATE
  // ===================================================

  isActive Boolean @default(true)

  isFeatured Boolean @default(false)

  // ===================================================
  // CATEGORY
  // ===================================================

  categoryId String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // ===================================================
  // NEW LEGACY-COMPATIBLE RELATIONS
  // ===================================================

  variants ProductVariant[]

  productImages ProductImage[]

  productInfo ProductInfo[]

  productHighlights ProductHighlight[]

  wishlistItems WishlistItem[]

  cartItems CartItem[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([brand])
  @@index([name])
  @@index([legacyId])
}

// =====================================================
// PRODUCT VARIANT
// =====================================================

model ProductVariant {
  id String @id @default(cuid())

  // Legacy product_variants.id
  legacyId Int? @unique

  name String

  price Decimal @db.Decimal(10, 2)

  sellingPrice Decimal @db.Decimal(10, 2)

  wholesalePrice Decimal? @db.Decimal(10, 2)

  stock Int @default(0)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems CartItem[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([legacyId])
}

// =====================================================
// PRODUCT IMAGE
// =====================================================

model ProductImage {
  id String @id @default(cuid())

  // Legacy product_images.id
  legacyId Int? @unique

  imageUrl String

  sortOrder Int @default(0)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([legacyId])
}

// =====================================================
// PRODUCT INFO
// =====================================================

model ProductInfo {
  id String @id @default(cuid())

  // Legacy product_info.id
  legacyId Int? @unique

  attribute String

  value String

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([legacyId])
}

// =====================================================
// PRODUCT HIGHLIGHT
// =====================================================

model ProductHighlight {
  id String @id @default(cuid())

  // Legacy product_highlights.id
  legacyId Int? @unique

  attribute String

  value String

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([legacyId])
}

// =====================================================
// BANNER
// =====================================================

model Banner {
  id String @id @default(cuid())

  // Legacy banner.id
  legacyId Int? @unique

  image String

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([legacyId])
}

// =====================================================
// ADDRESS
// =====================================================

model Address {
  id String @id @default(cuid())

  // Legacy delivery_address.id
  legacyId Int? @unique

  type AddressType @default(HOME)

  name String

  phone String

  addressLine1 String

  addressLine2 String?

  landmark String?

  city String

  state String

  pincode String

  latitude Decimal? @db.Decimal(10, 7)

  longitude Decimal? @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
  @@index([legacyId])
}

// =====================================================
// CART
// =====================================================

model Cart {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// CART ITEM
// =====================================================

model CartItem {
  id String @id @default(cuid())

  // Legacy cart_items.id
  legacyId Int? @unique

  quantity Int @default(1)

  // Legacy image snapshot
  imageUrl String?

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Legacy variant_id
  variantId String?

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([legacyId])
}

// =====================================================
// WISHLIST
// =====================================================

model WishlistItem {
  id String @id @default(cuid())

  // Legacy wishlist.id
  legacyId Int? @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([legacyId])
}

// =====================================================
// ORDER
// =====================================================

model Order {
  id String @id @default(cuid())

  // Legacy orders.id
  legacyId Int? @unique

  orderNumber String @unique

  status OrderStatus @default(PENDING)

  // ===================================================
  // PRICING SNAPSHOT
  // ===================================================

  subtotal Decimal @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  deliveryFee Decimal @default(0) @db.Decimal(10, 2)

  tax Decimal @default(0) @db.Decimal(10, 2)

  // Legacy orders.handling_charge
  handlingCharge Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  // ===================================================
  // CUSTOMER SNAPSHOT
  // ===================================================

  customerName String

  customerPhone String

  customerEmail String

  // ===================================================
  // LEGACY DELIVERY DATA
  // ===================================================

  deliveryDate String?

  deliveryTime String?

  gift String?

  legacyLocationId Int?

  // ===================================================
  // DELIVERY ADDRESS
  // ===================================================

  addressId String

  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  // ===================================================
  // USER
  // ===================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // ===================================================
  // COUPON
  // ===================================================

  couponId String?

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  couponCode String?

  // ===================================================
  // RELATIONS
  // ===================================================

  items OrderItem[]

  payments Payment[]

  notes String?

  // ===================================================
  // DATES
  // ===================================================

  placedAt DateTime @default(now())

  confirmedAt DateTime?

  deliveredAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([couponId])
  @@index([legacyId])
}

// =====================================================
// ORDER ITEM
// =====================================================

model OrderItem {
  id String @id @default(cuid())

  // Legacy order_items.id
  legacyId Int? @unique

  quantity Int

  // ===================================================
  // PRICE SNAPSHOT
  // ===================================================

  unitPrice Decimal @db.Decimal(10, 2)

  mrp Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  // ===================================================
  // PRODUCT SNAPSHOT
  // ===================================================

  productName String

  productSku String?

  productImage String?

  // ===================================================
  // ORDER
  // ===================================================

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ===================================================
  // PRODUCT
  // ===================================================

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // ===================================================
  // VARIANT
  // ===================================================

  variantId String?

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([legacyId])
}

// =====================================================
// COUPON
// =====================================================

model Coupon {
  id String @id @default(cuid())

  // Legacy coupon.id
  legacyId Int? @unique

  code String @unique

  description String?

  type CouponType

  value Decimal @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)

  maxDiscount Decimal? @db.Decimal(10, 2)

  usageLimit Int?

  usedCount Int @default(0)

  startsAt DateTime?

  expiresAt DateTime?

  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([legacyId])
}

// =====================================================
// PAYMENT
// =====================================================

model Payment {
  id String @id @default(cuid())

  // Legacy payment/order reference can be stored here
  legacyId Int? @unique

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  transactionId String?

  gatewayOrderId String?

  gatewayPaymentId String?

  refundId String?

  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([legacyId])
}

// =====================================================
// STORE SETTINGS
// =====================================================

model StoreSettings {
  id String @id @default(cuid())

  // Legacy store_settings.id
  legacyId Int? @unique

  isClosed Boolean @default(false)

  closedMessage String?

  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())

  @@index([legacyId])
}

// =====================================================
// DELIVERY SETTINGS
// =====================================================

model DeliverySettings {
  id String @id @default(cuid())

  legacyId Int? @unique

  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)

  handlingCharge Decimal @default(0) @db.Decimal(10, 2)

  freeDeliveryAbove Decimal? @db.Decimal(10, 2)

  minimumOrderAmount Decimal? @db.Decimal(10, 2)

  deliveryTime String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([legacyId])
}

// =====================================================
// DELIVERY LOCATION
// =====================================================

model District {
  id String @id @default(cuid())

  legacyId Int @unique

  name String

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legacyId])
}

// =====================================================
// CITY
// =====================================================

model City {
  id String @id @default(cuid())

  legacyId Int @unique

  name String

  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)

  districtId String

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([legacyId])
}

// =====================================================
// HELP / CONTACT SETTINGS
// =====================================================

model HelpSettings {
  id String @id @default(cuid())

  legacyId Int? @unique

  phone String?

  email String?

  whatsapp String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([legacyId])
}

// =====================================================
// OFFLINE MAP
// =====================================================

model OfflineMap {
  id String @id @default(cuid())

  legacyId Int @unique

  regionName String

  mapFileUrl String

  fileSizeMb Decimal? @db.Decimal(5, 2)

  uploadedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([legacyId])
}

// =====================================================
// WEBHOOK EVENT
// =====================================================

model WebhookEvent {
  id String @id @default(cuid())

  eventId String @unique

  event String

  processed Boolean @default(false)

  createdAt DateTime @default(now())

  processedAt DateTime?

  @@index([event])
  @@index([processed])
}
